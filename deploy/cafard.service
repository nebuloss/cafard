[Unit]
Description=cafard, logs and messages for agents and humans
Documentation=https://github.com/nebuloss/cafard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cafard
Group=cafard
# Serial ports are group dialout on Debian and Alpine alike.
SupplementaryGroups=dialout
ExecStart=/usr/local/bin/cafard serve -config /etc/cafard.yaml

Restart=on-failure
RestartSec=5s

# The database holds messages and the photos people dropped, plus token
# hashes. The hardening below is not ceremonial.
StateDirectory=cafard
StateDirectoryMode=0700

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=

# Serial ports live in /dev, so PrivateDevices=yes (an empty /dev) would hide
# them. Instead the real /dev stays visible and the device cgroup closes it:
# only the pseudo devices (null, zero, urandom...) and the serial classes
# below can be opened. /dev/serial/by-id/* are symlinks to these.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
DeviceAllow=char-ttyS rw

# It listens on the LAN (HTTP, and later syslog, netconsole) and calls out
# only to RFC 2217 serial servers on the LAN, so there is no IPAddressDeny.
# AF_UNIX is for the resolver and the journal.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Only the state directory is writable. If data_dir in /etc/cafard.yaml
# points elsewhere, change this line too.
ReadWritePaths=/var/lib/cafard

# The database, the photos and the WAL files are for this user only.
UMask=0077

# For syslog on port 514 (or HTTP on 80/443), uncomment both lines. Ports
# above 1024, the defaults, need no capability.
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
