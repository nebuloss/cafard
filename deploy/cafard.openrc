#!/sbin/openrc-run
# cafard under OpenRC: /etc/init.d/cafard, then `rc-update add cafard default`.
# Variables are read by openrc-run, not by this file.
# shellcheck shell=sh disable=SC2034
#
# An Alpine container is a reasonable place to run one static binary, and it
# has no systemd. The hardening a systemd unit would ask for has no OpenRC
# equivalent; what is kept is what OpenRC can express: an unprivileged account
# and a state directory only it can read. The rest is the container's job.

name="cafard"
description="messages, photos and logs between people, agents and machines"

config="/etc/cafard/config.yaml"
command="/usr/local/bin/cafard"
command_args="serve -config $config"
command_user="cafard:cafard"
command_background=true
pidfile="/run/cafard.pid"
umask=077

output_log="/var/log/cafard.log"
error_log="/var/log/cafard.log"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath --file --owner cafard:cafard --mode 0640 "$output_log"

    # Refuse to start rather than start wrong: `cafard config` fails on an
    # unknown key or on listeners that overlap, and says which.
    if ! "$command" config -config "$config" >/dev/null 2>&1; then
        eerror "the configuration in $config is not usable:"
        "$command" config -config "$config" 2>&1 | head -12
        return 1
    fi

    state_dir=$("$command" config -config "$config" 2>/dev/null | sed -n 's/^state-dir: *//p')
    checkpath --directory --owner cafard:cafard --mode 0700 "${state_dir:-/var/lib/cafard}"
}
