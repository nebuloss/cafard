#!/sbin/openrc-run
# Variables are read by openrc-run, not by this file.
# shellcheck shell=sh disable=SC2034
# cafard, under OpenRC: /etc/init.d/cafard, then `rc-update add cafard default`.
#
# An Alpine container is a reasonable place to run one static binary, and it
# has no systemd, so the unit beside this file does nothing there.
#
# The hardening the systemd unit asks for has no OpenRC equivalent. What is
# kept is what OpenRC can express: an unprivileged account (in dialout, for
# serial ports) and a data directory only it can read. The rest is the
# container's job.

name="cafard"
description="logs, photos and messages for agents and humans"

command="/usr/local/bin/cafard"
command_args="serve -config /etc/cafard.yaml"
# start-stop-daemon calls initgroups, so the dialout membership applies.
command_user="cafard:cafard"
command_background=true
pidfile="/run/cafard.pid"
umask=077

output_log="/var/log/cafard.log"
error_log="/var/log/cafard.log"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath --file --owner cafard:cafard --mode 0640 "$output_log"

    # Refuse to start rather than start wrong: `cafard config` fails on an
    # unknown key or a value that cannot mean what it says, and prints why.
    if ! "$command" config -config /etc/cafard.yaml >/dev/null 2>&1; then
        eerror "the configuration in /etc/cafard.yaml is not usable:"
        "$command" config -config /etc/cafard.yaml 2>&1 | head -12
        return 1
    fi

    # The data directory named in the configuration, mode 0700.
    data_dir=$("$command" config -config /etc/cafard.yaml 2>/dev/null |
        sed -n 's/^data_dir: *//p')
    checkpath --directory --owner cafard:cafard --mode 0700 "${data_dir:-/var/lib/cafard}"
}
