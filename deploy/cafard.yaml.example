# /etc/cafard.yaml
#
# Every key is optional: what is left out keeps the default shown here.
# Check the file after editing it, before restarting:
#
#   cafard config -config /etc/cafard.yaml
#
# It prints the effective configuration (secrets redacted) and fails on any
# error. Unknown keys are errors, so a typo is caught there rather than
# silently ignored.
#
# Every scalar key is also a flag and an environment variable, which win over
# this file in that order: http_listen is -http-listen and CAFARD_HTTP_LISTEN.
# Lists (retention.streams, mcp.allowed_origins, ...) are file-only.
#
# Commented-out keys show the shape of what is not set by default. Projects,
# their log sinks, serial ports, retention and members are set on the admin
# interface (/projects), not here.

# Where the database and the photos live. The installer creates it mode 0700,
# owned by the cafard user. The systemd unit only allows writes under
# /var/lib/cafard: change ReadWritePaths in the unit if you move it.
data_dir: /var/lib/cafard

# The public interface: the web UI for signed-in people, sign-in links
# (/p/...), the HTTP ingest API and MCP (/mcp). On a routable address cafard
# refuses to start unless an admin password is set; the installer sets one.
# Bind 127.0.0.1:8790 when a reverse proxy on the same machine fronts it.
http_listen: 0.0.0.0:8790

# The admin interface: password sign-in, tokens (Agents) and pairing (Pair).
# Empty, http_listen serves them too. Set, they answer 404 on http_listen
# and only this address serves them (with everything else), so http_listen
# can face a DMZ while this one stays on the internal network or on
# 127.0.0.1 behind an SSH tunnel. It must differ from http_listen.
# admin_listen: 127.0.0.1:8791

# The address phones and agents reach this server at, used in pairing QR codes
# and links. It cannot be worked out from a request behind a reverse proxy.
# The installer sets it to this machine's first address on a new install.
# public_url: http://10.0.50.2:8790

# HTTPS-only session cookies. Turn on when cafard is reached over HTTPS, either
# through tls_cert/tls_key below or through a reverse proxy.
secure: false

# Terminate TLS in cafard itself. Set both or neither. The files must be
# readable by the cafard user.
# tls_cert: /etc/cafard/tls.crt
# tls_key: /etc/cafard/tls.key

# cafard's own log: debug, info, warn or error. It never contains tokens,
# session ids, message text or image contents.
log_level: info

# These are the limits of what is outside projects (direct messages and
# their images), and the values a new project starts with; each project's
# own limits are set on its page of the admin interface.
retention:
  # Log lines older than this are deleted (0 keeps them forever).
  lines_max_age: 336h
  # Total size of log lines kept; the oldest go first (0 means no limit).
  lines_max_bytes: 2GB
  # Messages between agents and humans.
  messages_max_age: 2160h
  # Photos and other attachments.
  blobs_max_bytes: 5GB
  # Per-stream line age overrides; the first matching pattern wins.
  # streams:
  #   - pattern: "serial:*/*"
  #     lines_max_age: 720h

mcp:
  # Extra Origin values accepted on /mcp, for browser-based MCP clients.
  # Requests without an Origin header (terminal agents) are not affected.
  allowed_origins: []

# --- syslog -----------------------------------------------------------------
# A sender's lines land in the sink of a project that lists its address
# (set on the project page); lines from any other address are dropped and
# counted on Sources. allow filters before that. Port 514 needs
# CAP_NET_BIND_SERVICE (see the systemd unit). An empty address turns a
# listener off.
syslog:
  udp: ":5514"
  tcp: ":5514"
  # allow: ["10.0.50.0/24"]

# --- netconsole -------------------------------------------------------------
# Kernel command line: netconsole=@/,6666@<server-ip>/
# Senders are routed to sinks by address, as for syslog.
netconsole:
  udp: ":6666"
  # Deprecated: each entry is imported once, at start, as the address of a
  # sink of that name in the project imported. Remove it afterwards; the
  # sink's addresses are set on the project page.
  # names: { "10.0.50.42": dut1 }

# --- otlp -------------------------------------------------------------------
# POST /v1/logs, OTLP/HTTP protobuf or JSON, with a sink token, or with
# an ingest grant and service.name (else host.name) naming the sink.
otlp:
  enabled: true
  max_body_mib: 8

# --- messaging --------------------------------------------------------------
messaging:
  rate_per_minute: 30             # per principal, token bucket
  burst: 10
  channel_create_per_hour: 10
  archive_after: 336h             # runtime channels idle this long are archived

# --- images -----------------------------------------------------------------
images:
  max_file_mib: 20
  max_files: 10
  max_megapixels: 50              # larger images are refused (decompression bombs)

# --- channels ---------------------------------------------------------------
# Config channels cannot be renamed or deleted; their title, topic, bindings
# and surface can be edited until the next start.
# Reapplied at every start. A name is project/channel (the project is made
# when missing), or a bare name in the project imported. Bindings stay in
# the channel's project.
# channels:
#   - name: lab/general             # may set title and topic only
#     topic: anything not about one device
#   - name: lab/dut1
#     title: DUT 1 (x86 test board)
#     streams: [serial:lab/dut1, netconsole:lab/dut1, "syslog:lab/dut1*"]
#     surface: markers

# --- serial -----------------------------------------------------------------
# Deprecated: serial ports are set per sink on the project page now. At
# start, each port listed here is imported once as the port of the sink of
# its name in the project imported, and a warning says to remove the list.
# One entry per port: device (local), rfc2217 (host:port, line settings set
# from here) or tcp (raw, settings fixed on the far end). See README.md.
# The cafard user is in the dialout group, and the systemd unit allows
# /dev/ttyUSB*, /dev/ttyACM* and /dev/ttyS*. In an LXC container the host must
# pass the device through first (see deploy/README.md).
# serial:
#   - name: dut1
#     device: /dev/serial/by-id/usb-FTDI_FT232R_A1B2C3-if00-port0
#     baud: 115200
#     data_bits: 8
#     parity: none                  # none | even | odd | mark | space
#     stop_bits: 1
#     writable: false               # true: agents with serial_write and the claim may drive it
